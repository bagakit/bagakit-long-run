{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bagakit.dev/schema/long-run-outcome.schema.json",
  "title": "Long Run Outcome",
  "type": "object",
  "required": [
    "schema_version",
    "pass",
    "item_id",
    "status",
    "evidence",
    "anomaly_codes",
    "next_command",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "string",
      "enum": [
        "initializer",
        "coding",
        "endless_expand"
      ]
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "done",
        "in_progress",
        "blocked",
        "retry",
        "no_action"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "name",
          "result"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "anomaly_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_command": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "additionalProperties": true
}
